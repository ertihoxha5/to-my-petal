# Copy to backend/.env and adjust. Every setting can also be an environment variable.
# No secrets are required for local development: sessions use random server-side tokens.

# Database. SQLite for local work; use PostgreSQL (postgresql+psycopg://...) in production.
TMP_DATABASE_URL=sqlite:///./var/tomypetal.db

# Where uploaded photos are stored (private; served only to their owner through the API).
TMP_MEDIA_ROOT=./var/media

# Folder containing metadata.json + model.pt produced by ml/tomypetal_ml/train.py.
# If it is missing or fails validation, analyses honestly report "unavailable".
TMP_MODEL_DIR=./models/current
# PyTorch CPU threads per worker process (0 = PyTorch default).
TMP_TORCH_THREADS=0

# Browser origins allowed to call the API with cookies (comma-separated).
# Not needed when the frontend is served from the same origin (dev proxy or TMP_FRONTEND_DIST).
TMP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session cookie. Set TMP_COOKIE_SECURE=true whenever the site is served over HTTPS.
TMP_COOKIE_SECURE=false
TMP_COOKIE_SAMESITE=lax
TMP_SESSION_DAYS=30

# Upload limits.
TMP_MAX_UPLOAD_MB=12
TMP_MIN_IMAGE_SIDE=128
TMP_MAX_IMAGE_SIDE=12000
TMP_MAX_IMAGE_PIXELS=50000000

# Optional: serve the built frontend (frontend/dist) from the API origin.
# TMP_FRONTEND_DIST=../frontend/dist
